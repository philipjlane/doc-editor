{
  "version": "1.0",
  "topic": {
    "type": "concept",
    "metadata": {
      "title": "Getting Started with API Integration",
      "description": "A comprehensive guide to integrating with our REST API",
      "author": "Technical Documentation Team",
      "version": "1.0",
      "created": "2025-01-15T00:00:00.000Z",
      "modified": "2025-01-15T00:00:00.000Z",
      "tags": ["api", "integration", "rest", "tutorial"]
    },
    "sections": [
      {
        "title": "Introduction",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "This guide will help you get started with our REST API. The API provides programmatic access to all core features of the platform."
              }
            ]
          },
          {
            "type": "note",
            "noteType": "important",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "You will need an API key to access the endpoints. Contact support to obtain your credentials."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Authentication",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "All API requests must include an "
              },
              {
                "type": "text",
                "text": "Authorization",
                "styles": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": " header with your API key:"
              }
            ]
          },
          {
            "type": "codeBlock",
            "language": "bash",
            "content": "curl -H \"Authorization: Bearer YOUR_API_KEY\" \\\n  https://api.example.com/v1/resources"
          },
          {
            "type": "warning",
            "warningType": "danger",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Never expose your API key in client-side code or public repositories. Keep your credentials secure."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Making Your First Request",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Here's a simple example of fetching data from the API:"
              }
            ]
          },
          {
            "type": "example",
            "content": [
              {
                "type": "codeBlock",
                "language": "javascript",
                "content": "const response = await fetch('https://api.example.com/v1/resources', {\n  headers: {\n    'Authorization': 'Bearer YOUR_API_KEY',\n    'Content-Type': 'application/json'\n  }\n});\n\nconst data = await response.json();\nconsole.log(data);"
              }
            ]
          },
          {
            "type": "note",
            "noteType": "tip",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use the "
                  },
                  {
                    "type": "text",
                    "text": "Accept",
                    "styles": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": " header to specify the response format (e.g., "
                  },
                  {
                    "type": "text",
                    "text": "application/json",
                    "styles": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": " or "
                  },
                  {
                    "type": "text",
                    "text": "application/xml",
                    "styles": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": ")."
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
